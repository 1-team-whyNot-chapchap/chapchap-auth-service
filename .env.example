# Copy to .env. KEY=value; no export or surrounding quotes. Never commit real secrets.
APP_PORT=8081
APP_DESCRIPTION=Chapchap Auth API
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_db
DB_USER=chapchap
DB_PASSWORD=change-me
# Existing schema required. update is only for an explicitly disposable local DB.
JPA_DDL_AUTO=validate
SQL_INIT_MODE=never
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LISTENER_AUTO_STARTUP=false
GATEWAY_URI=http://localhost:8080
FRONTEND_CALLBACK_URI=http://localhost:5173/auth/callback
# Browser origin for refresh/logout. Deploy with the frontend origin, without a path or trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# Generate at least 32 random bytes, Base64 encode, and share only between Auth/Gateway.
# Below is a PUBLIC example value, never use for real login/deployment.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
IDENTITY_HMAC_SECRET=replace-with-a-separate-random-identity-secret
PORTONE_API_SECRET=replace-with-portone-api-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FILE_ENDPOINT_URI=http://localhost:9000
FILE_BUCKET=auth-profile
FILE_ACCESS_KEY=replace-with-minio-access-key
FILE_SECRET_KEY=replace-with-minio-secret-key
FILE_PROFILE_PATH=profiles
# Container-reachable external infrastructure.
COMPOSE_DB_HOST=host.docker.internal
COMPOSE_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
COMPOSE_FILE_ENDPOINT_URI=http://host.docker.internal:9000

# Internal Service JWT (disabled unless every key and client value is configured)
INTERNAL_SERVICE_JWT_ENABLED=false
INTERNAL_SERVICE_JWT_ISSUER=chapchap-auth-service
INTERNAL_SERVICE_JWT_KEY_ID=auth-1
INTERNAL_SERVICE_JWT_TOKEN_TTL_SECONDS=300
INTERNAL_SERVICE_JWT_PRIVATE_KEY_PEM=
INTERNAL_SERVICE_JWT_PUBLIC_KEY_PEM=
AUTH_CUSTOMER_SERVICE_CLIENT_SECRET=
AUTH_CUSTOMER_AI_CLIENT_SECRET=
